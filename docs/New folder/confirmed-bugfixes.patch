+/**
+ * Fixes every failing pair in one pass and returns a NEW SemanticColors object.
+ * Single source of truth for Step 6 "Auto-fix" and Step 10 "Fix all".
+ */
+export function autoFixSemantic(semantic: SemanticColors): SemanticColors {
+  const next = { ...semantic };
+  // Two passes: fixing one pair (e.g. fgDefault vs surface) can affect another.
+  for (let pass = 0; pass < 2; pass++) {
+    for (const issue of auditSemanticContrast(next).issues) {
+      if (!issue.passed) {
+        (next as Record<string, string>)[issue.fgKey] = nudgeToContrast(
+          (next as Record<string, string>)[issue.fgKey], issue.bg, issue.targetRatio
+        );
+      }
+    }
+  }
+  return next;
+}
