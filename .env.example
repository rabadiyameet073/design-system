# GEMINI_API_KEY: Required for Gemini AI design prompt generation
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public base URL where this app is hosted (e.g. http://localhost:3000 or https://your-project.vercel.app)
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic secret for signing per-user session cookies (HMAC-SHA256)
SESSION_SECRET="your_strong_random_session_secret_32_characters_minimum"

# GOOGLE OAUTH 2.0 CONFIGURATION (Identity verification only: openid, profile, email)
OAUTH_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
OAUTH_CLIENT_SECRET="your_google_oauth_client_secret"

# GOOGLE FONTS DEVELOPER API (Optional: used by /api/fonts proxy, falls back to local snapshot if omitted)
GOOGLE_FONTS_API_KEY="your_google_fonts_developer_api_key"

# GITHUB OAUTH (Optional: only needed if enabling GitHub authentication)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
